{
  "name": "NowIGetIt",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "containerEnv": {
    "ENABLE_MANIM_RENDER": "true"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "src/app/page.tsx", "api/index.py"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt && npm install",
  "postAttachCommand": {
    "api": "uvicorn api.index:app --host 0.0.0.0 --port 8000 --reload",
    "web": "npm run dev -- --hostname 0.0.0.0 --port 3000"
  },
  "portsAttributes": {
    "3000": {
      "label": "Next.js",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "FastAPI"
    }
  },
  "forwardPorts": [3000, 8000]
}
