# Railway Docling conversion worker (PDF/PPTX/DOCX → HTML)
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DOCLING_WORKER_MODE=true \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/tmp/huggingface

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-docling.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-docling.txt

COPY backend ./backend
COPY docling_worker ./docling_worker

EXPOSE 8080
CMD ["sh", "-c", "uvicorn docling_worker.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
