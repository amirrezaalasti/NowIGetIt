# OpenRouter — text LLM + separate vision model for frame review
# Users can also paste their own key in the account menu (BYOK).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Manim pipeline (planning, codegen, code QA). Falls back to OPENROUTER_MODEL if unset.
OPENROUTER_MODEL_MANIM=google/gemini-3.6-flash
# Multimodal only (image VLM). Cheap default: gemini-2.5-flash-lite (~$0.10/$0.40 per 1M)
OPENROUTER_VLM_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: site headers for OpenRouter rankings
OPENROUTER_SITE_URL=https://nowigetit.app
OPENROUTER_APP_NAME=NowIGetIt

# TTS via OpenRouter (OpenAI-compatible /audio/speech)
# Leave TTS_API_KEY blank to reuse OPENROUTER_API_KEY
# TTS_API_KEY=
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_MODEL=google/gemini-3.1-flash-tts-preview
TTS_VOICE=Kore

# Local Manim rendering (requires manim + ffmpeg + Python 3.12 venv)
ENABLE_MANIM_RENDER=true
MAX_SCENE_REVISIONS=3
# Auto-revise scenes when VLM rejects or clarity is below threshold.
# Revisions keep the best-scoring attempt and stop after a non-improving try.
ENABLE_AUTO_VLM_REVISE=true
VLM_CLARITY_THRESHOLD=0.55
# Scenes are generated sequentially (each one builds on the actual code/narration
# of the scene before it) — there is no parallelism knob anymore.

# Frontend → API (local: FastAPI on 8000; prod: same-origin /api)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Auth.js (Google) — shared AUTH_SECRET must be set for both Next.js and FastAPI
# Generate: openssl rand -hex 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional local override (defaults to http://localhost:3000)
# AUTH_URL=http://localhost:3000

# ChatGPT / Claude MCP connector (https://<host>/api/mcp).
# Users sign in with Google (same AUTH_GOOGLE_* as the website). Jobs go to their Library.
# Optional shared bearer token for Inspector only — not needed for ChatGPT/Claude.
# MCP_CONNECTOR_TOKEN=

# Storage: MongoDB Atlas (users/jobs/usage) + local files (videos).
# Videos/docs stay under ARTIFACTS_ROOT (./artifacts locally).
USE_SUPABASE=false
MONGODB_URI=
MONGODB_DB=nowigetit

# Optional — only if you opt back into Supabase later
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Optional estimate used when reserving a generation slot
# DEFAULT_LLM_ESTIMATE_TOKENS=25000

# Railway Manim render worker (production). When set, Vercel API offloads Manim here.
# RENDER_WORKER_URL=https://your-service.up.railway.app
# RENDER_WORKER_SECRET=long-random-shared-secret
# On the Railway service: ENABLE_MANIM_RENDER=true, RENDER_WORKER_MODE=true, same SECRET
# Do NOT set RENDER_WORKER_URL on Railway (only on Vercel / local clients).

# Railway Docling worker (Understand mode: PDF/PPTX/DOCX → HTML slides).
# Local: pip install -r requirements-docling.txt  OR set the remote worker URL.
# DOCLING_WORKER_URL=https://your-docling-service.up.railway.app
# DOCLING_WORKER_SECRET=long-random-shared-secret
# On that Railway service: DOCLING_WORKER_MODE=true, same SECRET; use Dockerfile.docling
# Do NOT set DOCLING_WORKER_URL on the Docling Railway service itself.
# OCR is off by default (faster for digital PDFs). Set true for scanned pages.
# DOCLING_DO_OCR=false
# Keep figures + decode formulas (recommended). Scale ~1.5–2.0 for sharper images.
# DOCLING_FORMULA_ENRICHMENT=true
# DOCLING_IMAGES_SCALE=1.5
