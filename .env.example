# OpenRouter — text LLM + separate vision model for frame review
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Multimodal only (image VLM). Cheap default: gemini-2.5-flash-lite (~$0.10/$0.40 per 1M)
OPENROUTER_VLM_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: site headers for OpenRouter rankings
OPENROUTER_SITE_URL=https://nowigetit.app
OPENROUTER_APP_NAME=NowIGetIt

# TTS via OpenAI-compatible API (OpenRouter does not serve TTS)
# Leave blank to synthesize silent placeholders / skip audio mux
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Local Manim rendering (requires manimgl + ffmpeg + Python 3.12 venv)
ENABLE_MANIM_RENDER=true
MAX_SCENE_REVISIONS=5

# Frontend → API (local: FastAPI on 8000; prod: same-origin /api)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Auth.js (Google) — shared AUTH_SECRET must be set for both Next.js and FastAPI
# Generate: openssl rand -hex 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional local override (defaults to http://localhost:3000)
# AUTH_URL=http://localhost:3000

# Supabase (users, quotas, usage) — project https://supabase.com/dashboard/project/rhoulajitzoaxivyfvxn
NEXT_PUBLIC_SUPABASE_URL=https://rhoulajitzoaxivyfvxn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: Settings → API → service_role (never expose to the browser)
SUPABASE_URL=https://rhoulajitzoaxivyfvxn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional estimate used when reserving a generation slot
# DEFAULT_LLM_ESTIMATE_TOKENS=25000

# Railway Manim render worker (production). When set, Vercel API offloads Manim here.
# RENDER_WORKER_URL=https://your-service.up.railway.app
# RENDER_WORKER_SECRET=long-random-shared-secret
# On the Railway service: ENABLE_MANIM_RENDER=true, RENDER_WORKER_MODE=true, same SECRET
# Do NOT set RENDER_WORKER_URL on Railway (only on Vercel / local clients).
